def required(name)
  value = ENV[name]
  UI.user_error!("Missing #{name}") if value.to_s.empty?
  value
end
default_platform(:ios)
platform :ios do
  desc 'Sign, upload and wait for processing (internal TestFlight only)'
  lane :beta do
    team = required('APPLE_TEAM_ID')
    profile = required('PROFILE_NAME')
    key = app_store_connect_api_key(key_id: required('ASC_KEY_ID'), issuer_id: required('ASC_ISSUER_ID'), key_content: required('ASC_KEY_P8_BASE64'), is_key_content_base64: true)
    increment_build_number(build_number: required('BUILD_NUMBER'), xcodeproj: 'CardLedger.xcodeproj')
    require 'shellwords'
    args = { 'DEVELOPMENT_TEAM' => team, 'CODE_SIGN_STYLE' => 'Manual', 'CODE_SIGN_IDENTITY' => 'Apple Distribution', 'PROVISIONING_PROFILE_SPECIFIER' => profile }.map { |k, v| "#{k}=#{Shellwords.escape(v)}" }.join(' ')
    build_app(project: 'CardLedger.xcodeproj', scheme: 'CardLedger', export_method: 'app-store', output_directory: 'build', xcargs: args, export_options: { signingStyle: 'manual', teamID: team, provisioningProfiles: {'com.jverdi.cardledger' => profile} })
    sh('python3', File.expand_path('../scripts/validate-ipa.py', __dir__), lane_context[SharedValues::IPA_OUTPUT_PATH])
    upload_to_testflight(api_key: key, app_identifier: 'com.jverdi.cardledger', skip_waiting_for_build_processing: false, distribute_external: false, changelog: 'Collection rows now have clearer typography, larger thumbnails and compact pricing. Card type replaces Sport and includes non-sports cards such as Pokémon. Existing and new metadata are normalized consistently; seasons use their starting year. Sort by Date added, surname, Year or Value, with both directions available. Empty filtered results offer Clear filters. Scanning tolerates gentle hand movement with a shorter capture window, and each face independently detects portrait or landscape reading direction. Please evaluate handheld capture and cards with a portrait front and landscape back. Hands-free batch scanning, duplicate review, original photos and owner-entered values are preserved.')
  end
end

