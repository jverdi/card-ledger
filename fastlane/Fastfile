def required(name)
  value = ENV[name]
  UI.user_error!("Missing #{name}") if value.to_s.empty?
  value
end
default_platform(:ios)
platform :ios do
  desc 'Sign, upload and wait for processing (internal TestFlight only)'
  lane :beta do
    team = required('APPLE_TEAM_ID')
    profile = required('PROFILE_NAME')
    key = app_store_connect_api_key(key_id: required('ASC_KEY_ID'), issuer_id: required('ASC_ISSUER_ID'), key_content: required('ASC_KEY_P8_BASE64'), is_key_content_base64: true)
    increment_build_number(build_number: required('BUILD_NUMBER'), xcodeproj: 'CardLedger.xcodeproj')
    require 'shellwords'
    args = { 'DEVELOPMENT_TEAM' => team, 'CODE_SIGN_STYLE' => 'Manual', 'CODE_SIGN_IDENTITY' => 'Apple Distribution', 'PROVISIONING_PROFILE_SPECIFIER' => profile }.map { |k, v| "#{k}=#{Shellwords.escape(v)}" }.join(' ')
    build_app(project: 'CardLedger.xcodeproj', scheme: 'CardLedger', export_method: 'app-store', output_directory: 'build', xcargs: args, export_options: { signingStyle: 'manual', teamID: team, provisioningProfiles: {'com.jverdi.cardledger' => profile} })
    sh('python3', File.expand_path('../scripts/validate-ipa.py', __dir__), lane_context[SharedValues::IPA_OUTPUT_PATH])
    upload_to_testflight(api_key: key, app_identifier: 'com.jverdi.cardledger', skip_waiting_for_build_processing: false, distribute_external: false, changelog: 'Personal beta: front/back capture, manual crop and rotation, OCR-assisted identity, offline inventory, manual values, purchase/sale details, filters and verified backups. Automatic pricing requires a configured private worker.')
  end
end
